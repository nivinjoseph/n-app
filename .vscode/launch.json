{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug framework tests (Vitest)",
            "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
            "args": ["run", "--no-file-parallelism"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "smartStep": true,
            "sourceMaps": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug example tests (Vitest)",
            "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
            "args": ["run", "--no-file-parallelism"],
            "cwd": "${workspaceFolder}/working-example",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "smartStep": true,
            "sourceMaps": true
        },
        {
            "name": "Debug example client (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/working-example/src",
            "sourceMaps": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug example server (n-web)",
            "program": "${workspaceFolder}/working-example/dist-server/server.js",
            "cwd": "${workspaceFolder}/working-example",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true
        }
    ]
}
