{
    // NOTE: no "typescript.tsdk" here on purpose. This repo builds with
    // TypeScript 7 (the native/Go compiler), whose package ships only `tsc` —
    // there is no tsserver.js or lib.*.d.ts to point an SDK path at. VS Code
    // uses its own bundled TypeScript for editor intellisense; install the
    // "TypeScript (Native Preview)" extension if you want TS 7 in the editor.
    // `yarn typecheck` is the authority either way.

    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports.biome": "explicit"
    },
    "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
    "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
    "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
    "[json]": { "editor.defaultFormatter": "biomejs.biome" },
    "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
    "[css]": { "editor.defaultFormatter": "biomejs.biome" },

    "editor.trimAutoWhitespace": false,
    "editor.rulers": [80],
    "editor.wordWrapColumn": 80,
    "typescript.updateImportsOnFileMove.enabled": "prompt",
    "typescript.preferences.importModuleSpecifierEnding": "js",

    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/.yarn/cache": true,
        // The root ./dist is committed and published — keep it visible. Only
        // the example's build output is hidden.
        "working-example/dist": true,
        "**/dist-server": true,
        "**/*.tsbuildinfo": true
    },

    "cSpell.userWords": [
        "biomejs",
        "mobx",
        "nivinjoseph",
        "oxlint",
        "Repo",
        "rolldown",
        "tsgo",
        "unplugin",
        "vitest"
    ]
}
